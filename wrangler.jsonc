{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "producer-worker",
	"main": "src/entry.py",
	"compatibility_date": "2026-08-06",
	"compatibility_flags": [
		"python_workers"
	],
	"observability": {
		"enabled": true
	},
	"queues": {
		"producers": [
			{
				"queue": "queue-name",
				"binding": "MY_QUEUE"
			}
		]
	}
}